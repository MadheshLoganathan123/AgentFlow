# AgentFlow Environment Configuration Template
# Mode: Lightweight Open-Source Tech Stack (Zero Heavyweight Daemons, CPU Friendly)

ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

POSTGRES_USER=agentflow
POSTGRES_PASSWORD=agentflow_dev_password
POSTGRES_DB=agentflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow_dev_password@localhost:5432/agentflow
DATABASE_URL_SYNC=postgresql+psycopg2://agentflow:agentflow_dev_password@localhost:5432/agentflow

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="AgentFlow Copilot"
PORT=3000

LANGGRAPH_CHECKPOINT_SAVER=memory
LANGGRAPH_MAX_RETRIES=3

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=15

LLM_PROVIDER=deterministic
EMBEDDING_PROVIDER=tfidf
