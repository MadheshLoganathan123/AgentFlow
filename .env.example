# AgentFlow Environment Configuration (Template)
# Copy this file to .env before starting services

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=agentflow_dev_password
POSTGRES_DB=agentflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow_dev_password@localhost:5432/agentflow
DATABASE_URL_SYNC=postgresql+psycopg2://agentflow:agentflow_dev_password@localhost:5432/agentflow

# Frontend Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="AgentFlow Copilot"
PORT=3000

# LangGraph & Checkpoint Configuration
LANGGRAPH_CHECKPOINT_SAVER=postgres # options: postgres, memory
LANGGRAPH_MAX_RETRIES=3

# Object Storage / File Uploads
STORAGE_BACKEND=local # options: local, s3, minio
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=15

# LLM Providers (Open Source / Local / API compatible)
# Local inference option: Ollama / vLLM / LocalAI
OPENAI_API_BASE=http://localhost:11434/v1 # Defaults to local Ollama if used
OPENAI_API_KEY=not-needed-for-local
LLM_MODEL_NAME=llama3.1:8b
EMBEDDING_MODEL_NAME=nomic-embed-text

